rules_version = '2';

// Firestore security rules for the DrivePro Driving School Management System.
// Deploy with:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers

    function isSignedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return hasProfile() ? profile().role : 'student';
    }

    function isAdmin() {
      return isSignedIn() && role() == 'admin';
    }

    // Staff share the admin operational surface but not settings.
    function isStaff() {
      return isSignedIn() && (role() == 'admin' || role() == 'staff');
    }

    function isInstructor() {
      return isSignedIn() && role() == 'instructor';
    }

    // The student id linked to the signed-in account, if any.
    function linkedStudentId() {
      return hasProfile() ? profile().get('studentId', '') : '';
    }

    function ownsStudentRecord(studentId) {
      return isSignedIn() && linkedStudentId() == studentId;
    }

    // ------------------------------------------------------------------ users

    match /users/{userId} {
      // A signed-in user reads their own profile; staff read everyone.
      allow read: if isSignedIn() && (request.auth.uid == userId || isStaff());

      // A new account may create its own profile, but never grant itself a
      // privileged role — only an admin can hand out admin/staff/instructor.
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == 'student';

      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role;

      allow create, update, delete: if isAdmin();
    }

    // --------------------------------------------------------------- students

    match /students/{studentId} {
      allow read: if isStaff() || isInstructor() || ownsStudentRecord(studentId);
      allow create, update, delete: if isStaff();
    }

    // ------------------------------------------------- per-student sub-records

    match /attendance/{recordId} {
      allow read: if isStaff()
        || isInstructor()
        || ownsStudentRecord(resource.data.studentId);
      allow create, update, delete: if isStaff() || isInstructor();
    }

    match /classes/{classId} {
      allow read: if isStaff()
        || isInstructor()
        || ownsStudentRecord(resource.data.studentId);
      allow create, update, delete: if isStaff() || isInstructor();
    }

    match /licenseApplications/{applicationId} {
      allow read: if isStaff() || ownsStudentRecord(resource.data.studentId);
      allow create, update, delete: if isStaff();
    }

    match /payments/{paymentId} {
      allow read: if isStaff() || ownsStudentRecord(resource.data.studentId);
      allow create, update, delete: if isStaff();
    }

    match /documents/{documentId} {
      allow read: if isStaff() || ownsStudentRecord(resource.data.studentId);
      allow create, update, delete: if isStaff();
    }

    // ----------------------------------------------------- shared reference data

    // Courses, instructors and vehicles are shown on the public website.
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /instructors/{instructorId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /vehicles/{vehicleId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /branches/{branchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------- notifications

    match /notifications/{notificationId} {
      allow read: if isStaff()
        || (isSignedIn() && resource.data.audience == 'all')
        || (isSignedIn()
            && resource.data.audience == 'student'
            && ownsStudentRecord(resource.data.get('studentId', '')));
      allow create, update, delete: if isStaff();
    }

    // ------------------------------------------------------------------ leads

    // The public contact form writes enquiries; only staff may read them back.
    match /leads/{leadId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'phone'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 1
        && request.resource.data.name.size() < 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() < 20;
      allow read, update, delete: if isStaff();
    }

    // --------------------------------------------------------------- settings

    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ========================================================================
    // TAMIL MOTORS — dealership management system
    // ------------------------------------------------------------------------
    // Namespaced under tamilMotors_* so it cannot reach Driving School data.
    // Role comes from the auth custom claim first (no extra document read),
    // falling back to the tamilMotors_users profile document.
    // ========================================================================

    function tmHasProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/tamilMotors_users/$(request.auth.uid));
    }

    function tmProfileRole() {
      return tmHasProfile()
        ? get(/databases/$(database)/documents/tamilMotors_users/$(request.auth.uid)).data.get('role', 'guest')
        : 'guest';
    }

    function tmRole() {
      return isSignedIn() ? request.auth.token.get('role', tmProfileRole()) : 'guest';
    }

    function tmIsAdmin() {
      return tmRole() == 'admin';
    }

    // Everyone who works at the dealership.
    function tmIsStaff() {
      return tmRole() in ['admin', 'manager', 'sales', 'accountant'];
    }

    // Staff who may see money: revenue, payments, expenses, finance.
    function tmIsFinance() {
      return tmRole() in ['admin', 'manager', 'accountant'];
    }

    function tmIsCustomer() {
      return tmRole() == 'customer';
    }

    // A customer may only see rows that belong to them.
    function tmOwnsByEmail() {
      return isSignedIn() && resource.data.get('email', '') == request.auth.token.email;
    }

    function tmOwnsByCustomerId() {
      return isSignedIn()
        && tmHasProfile()
        && resource.data.get('customerId', '')
           == get(/databases/$(database)/documents/tamilMotors_users/$(request.auth.uid)).data.get('customerId', '');
    }

    // Shape checks for the two writes the public website is allowed to make.
    function tmValidContact() {
      return request.resource.data.get('name', '') is string
        && request.resource.data.name.size() > 1
        && request.resource.data.name.size() < 120
        && request.resource.data.get('phone', '') is string
        && request.resource.data.phone.size() > 5
        && request.resource.data.phone.size() < 20;
    }

    // ------------------------------------------------------------ tm/users

    match /tamilMotors_users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || tmIsStaff());

      // A new account registers itself as a customer and can never self-promote.
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.get('role', '') == 'customer';

      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.get('role', '') == resource.data.get('role', '');

      allow create, update, delete: if tmIsAdmin();
    }

    // ------------------------------------------------- public catalog (read)

    // The showroom catalog is public; only staff may change stock or pricing.
    match /tamilMotors_bikes/{bikeId} {
      allow read: if true;
      allow create, update, delete: if tmIsStaff();
    }

    match /tamilMotors_settings/{settingId} {
      allow read: if true;
      allow write: if tmIsAdmin();
    }

    // ------------------------------------------------------- test drives

    match /tamilMotors_testDrives/{testDriveId} {
      // The public booking form may create a request, nothing more.
      allow create: if tmValidContact()
        && request.resource.data.get('status', '') == 'Requested';

      allow read: if tmIsStaff() || tmOwnsByEmail();
      allow update, delete: if tmIsStaff();
    }

    // --------------------------------------------------------- customers

    match /tamilMotors_customers/{customerId} {
      // The website enquiry form creates leads only.
      allow create: if tmValidContact()
        && request.resource.data.get('status', '') == 'lead';

      allow read: if tmIsStaff() || tmOwnsByEmail();
      allow update, delete: if tmIsStaff();
    }

    // ------------------------------------------- customer-visible records

    match /tamilMotors_sales/{saleId} {
      allow read: if tmIsStaff() || tmOwnsByCustomerId();
      allow create, update: if tmIsStaff();
      allow delete: if tmIsAdmin();
    }

    match /tamilMotors_bookings/{bookingId} {
      allow read: if tmIsStaff() || tmOwnsByCustomerId();
      allow create, update: if tmIsStaff();
      allow delete: if tmIsAdmin();
    }

    match /tamilMotors_payments/{paymentId} {
      allow read: if tmIsFinance() || tmOwnsByCustomerId();
      allow create, update: if tmIsFinance();
      allow delete: if tmIsAdmin();
    }

    match /tamilMotors_insurance/{policyId} {
      allow read: if tmIsStaff() || tmOwnsByCustomerId();
      allow create, update: if tmIsStaff();
      allow delete: if tmIsAdmin();
    }

    // ------------------------------------------------------ staff only

    match /tamilMotors_inventory/{itemId} {
      allow read: if tmIsStaff();
      allow create, update: if tmIsStaff();
      allow delete: if tmIsAdmin();
    }

    match /tamilMotors_employees/{employeeId} {
      allow read: if tmIsStaff();
      allow write: if tmIsAdmin();
    }

    match /tamilMotors_followups/{followUpId} {
      allow read, create, update: if tmIsStaff();
      allow delete: if tmIsAdmin();
    }

    match /tamilMotors_notifications/{notificationId} {
      // Public forms raise a notification for the sales desk; nobody outside
      // the dealership can read them back.
      allow create: if tmIsStaff()
        || request.resource.data.get('type', '') in ['Test Drive Request', 'New Customer'];
      allow read, update: if tmIsStaff();
      allow delete: if tmIsAdmin();
    }

    // --------------------------------------------------- finance & money

    match /tamilMotors_finance/{applicationId} {
      allow read: if tmIsFinance() || tmOwnsByCustomerId();
      allow create, update: if tmIsFinance();
      allow delete: if tmIsAdmin();
    }

    match /tamilMotors_expenses/{expenseId} {
      allow read, create, update: if tmIsFinance();
      allow delete: if tmIsAdmin();
    }

    // Anything not matched above is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
